<?xml version="1.0" encoding="UTF-8"?>
<infinispan
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="urn:infinispan:config:13.0 https://infinispan.org/schemas/infinispan-config-13.0.xsd"
    xmlns="urn:infinispan:config:13.0">
    
    <jgroups>
        <stack name="apix-jgroups-stack" extends="udp">
            <UDP bind_addr="${jgroups.bind_addr:SITE_LOCAL}"
                 bind_port="${jgroups.bind_port:0}"
                 mcast_addr="${jgroups.mcast_addr:228.6.7.8}"
                 mcast_port="${jgroups.mcast_port:46655}"
                 tos="8"
                 ucast_recv_buf_size="20M"
                 ucast_send_buf_size="640K"
                 mcast_recv_buf_size="25M"
                 mcast_send_buf_size="640K"
                 max_bundle_size="31K"
                 ip_ttl="${jgroups.ip_ttl:2}"
                 enable_diagnostics="false"
                 thread_naming_pattern="pl"
                 thread_pool.min_threads="0"
                 thread_pool.max_threads="200"
                 thread_pool.keep_alive_time="60000"/>
            <PING />
            <MERGE3 max_interval="30000" min_interval="10000"/>
            <FD_SOCK/>
            <FD_ALL timeout="10000" interval="3000"/>
            <VERIFY_SUSPECT timeout="1500"/>
            <pbcast.NAKACK2 xmit_interval="500"
                           xmit_table_num_rows="100"
                           xmit_table_msgs_per_row="2000"
                           xmit_table_max_compaction_time="30000"
                           use_mcast_xmit="false"
                           discard_delivered_msgs="true"/>
            <UNICAST3 xmit_interval="500"
                     xmit_table_num_rows="100"
                     xmit_table_msgs_per_row="2000"
                     xmit_table_max_compaction_time="60000"
                     conn_expiry_timeout="0"/>
            <pbcast.STABLE desired_avg_gossip="50000"
                          max_bytes="4M"/>
            <pbcast.GMS print_local_addr="true"
                       join_timeout="2000"/>
            <UFC max_credits="2M" min_threshold="0.4"/>
            <MFC max_credits="2M" min_threshold="0.4"/>
            <FRAG2 frag_size="30K"/>
        </stack>
    </jgroups>
    
    <cache-container name="apix-cluster" default-cache="distributed-cache">
        <transport stack="apix-jgroups-stack" cluster="apix-cluster" node-name="${infinispan.node.name:apix-node}"/>
        
        <distributed-cache name="distributed-cache">
            <memory>
                <off-heap size="10000" eviction="MEMORY"/>
            </memory>
        </distributed-cache>
        
        <replicated-cache name="__vertx.subs">
            <expiration interval="-1"/>
        </replicated-cache>
        
        <replicated-cache name="__vertx.haInfo">
            <expiration interval="-1"/>
        </replicated-cache>
        
        <replicated-cache name="__vertx.nodeInfo">
            <expiration interval="-1"/>
        </replicated-cache>
        
        <distributed-cache name="__vertx.distributed.cache">
            <memory>
                <off-heap size="10000" eviction="MEMORY"/>
            </memory>
        </distributed-cache>
    </cache-container>
</infinispan>
