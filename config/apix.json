{
  "gateway" : {
    "host" : "0.0.0.0",
    "port" : 8080
  },
  "admin" : {
    "enabled" : true,
    "port" : 8081,
    "host" : "0.0.0.0"
  },
  "plugins" : [ {
    "id" : "rate-limiter",
    "type" : "rate-limiter",
    "config" : {
      "limit" : 100,
      "window" : 60
    }
  }, {
    "id" : "auth",
    "type" : "api-key",
    "config" : {
      "header" : "X-API-Key",
      "keys" : [ "test-key" ]
    }
  }, {
    "id" : "prompt-validator",
    "type" : "prompt-validator",
    "config" : {
      "max_length" : 4000,
      "validate_json" : true
    }
  }, {
    "id" : "request-logger",
    "type" : "request-logger",
    "config" : {
      "log_level" : "info",
      "include_headers" : true,
      "include_body" : false,
      "mask_headers" : [ "authorization", "x-api-key" ]
    }
  }, {
    "id" : "response-cache",
    "type" : "response-cache",
    "config" : {
      "ttl_seconds" : 300,
      "max_size" : 1000,
      "methods" : [ "POST" ],
      "status_codes" : [ 200 ]
    }
  }, {
    "id" : "token-usage",
    "type" : "token-usage",
    "config" : {
      "track_by_model" : true,
      "track_by_user" : true,
      "user_id_header" : "X-User-ID"
    }
  }, {
    "id" : "header-transform",
    "type" : "transform",
    "config" : {
      "request" : {
        "headers" : {
          "X-Gateway-Version" : "1.0.0"
        }
      },
      "response" : {
        "headers" : {
          "X-Powered-By" : "APIX Gateway"
        }
      }
    }
  }, {
    "id" : "test-plugin-update",
    "type" : "response-cache",
    "config" : {
      "ttl_seconds" : 600,
      "max_size" : 2000
    },
    "enabled" : false,
    "dependencies" : [ ]
  }, {
    "id" : "test-plugin",
    "type" : "response-cache",
    "config" : {
      "ttl_seconds" : 300,
      "max_size" : 1000
    },
    "enabled" : true,
    "dependencies" : [ ]
  }, {
    "id" : "test-plugin-enable-disable",
    "type" : "response-cache",
    "config" : {
      "ttl_seconds" : 300,
      "max_size" : 1000
    },
    "enabled" : false,
    "dependencies" : [ ]
  }, {
    "id" : "test-plugin-reload",
    "type" : "response-cache",
    "config" : {
      "ttl_seconds" : 300,
      "max_size" : 1000
    },
    "enabled" : true,
    "dependencies" : [ ]
  } ],
  "routes" : [ {
    "id" : "openai-chat",
    "name" : "OpenAI Chat Completions",
    "path" : "/v1/chat/completions",
    "methods" : [ "POST" ],
    "targetUrl" : "https://api.openai.com/v1/chat/completions",
    "plugins" : [ "rate-limiter", "auth", "prompt-validator", "request-logger", "response-cache", "token-usage", "header-transform" ],
    "enabled" : true
  }, {
    "id" : "anthropic-messages",
