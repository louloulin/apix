#!/bin/bash

# APIX Gateway 10万并发优化启动脚本
# 此脚本针对10万并发连接进行了极致优化

echo "===== 启动10万并发优化版 APIX Gateway ====="

# 设置系统参数
echo "设置系统参数..."
ulimit -n 1000000 || echo "警告: 无法设置文件描述符限制，可能需要 root 权限"

# 设置操作系统参数（需要 root 权限）
if [ "$(uname)" == "Linux" ]; then
  echo "尝试设置 Linux 内核参数..."
  sudo sysctl -w net.core.somaxconn=100000 || echo "警告: 无法设置 net.core.somaxconn"
  sudo sysctl -w net.ipv4.tcp_max_syn_backlog=100000 || echo "警告: 无法设置 net.ipv4.tcp_max_syn_backlog"
  sudo sysctl -w net.ipv4.ip_local_port_range="1024 65535" || echo "警告: 无法设置 net.ipv4.ip_local_port_range"
  sudo sysctl -w net.ipv4.tcp_tw_reuse=1 || echo "警告: 无法设置 net.ipv4.tcp_tw_reuse"
  sudo sysctl -w net.ipv4.tcp_fin_timeout=5 || echo "警告: 无法设置 net.ipv4.tcp_fin_timeout"
  sudo sysctl -w net.core.netdev_max_backlog=250000 || echo "警告: 无法设置 net.core.netdev_max_backlog"
  sudo sysctl -w net.ipv4.tcp_keepalive_time=300 || echo "警告: 无法设置 net.ipv4.tcp_keepalive_time"
  sudo sysctl -w net.ipv4.tcp_keepalive_intvl=30 || echo "警告: 无法设置 net.ipv4.tcp_keepalive_intvl"
  sudo sysctl -w net.ipv4.tcp_keepalive_probes=5 || echo "警告: 无法设置 net.ipv4.tcp_keepalive_probes"
  sudo sysctl -w net.core.rmem_max=67108864 || echo "警告: 无法设置 net.core.rmem_max"
  sudo sysctl -w net.core.wmem_max=67108864 || echo "警告: 无法设置 net.core.wmem_max"
  sudo sysctl -w net.ipv4.tcp_rmem="4096 87380 67108864" || echo "警告: 无法设置 net.ipv4.tcp_rmem"
  sudo sysctl -w net.ipv4.tcp_wmem="4096 65536 67108864" || echo "警告: 无法设置 net.ipv4.tcp_wmem"
  sudo sysctl -w net.ipv4.tcp_max_tw_buckets=6000000 || echo "警告: 无法设置 net.ipv4.tcp_max_tw_buckets"
  sudo sysctl -w net.ipv4.tcp_mtu_probing=1 || echo "警告: 无法设置 net.ipv4.tcp_mtu_probing"
  sudo sysctl -w net.ipv4.tcp_slow_start_after_idle=0 || echo "警告: 无法设置 net.ipv4.tcp_slow_start_after_idle"
  sudo sysctl -w net.ipv4.tcp_mem="786432 2097152 67108864" || echo "警告: 无法设置 net.ipv4.tcp_mem"
  sudo sysctl -w net.core.optmem_max=33554432 || echo "警告: 无法设置 net.core.optmem_max"
elif [ "$(uname)" == "Darwin" ]; then
  echo "在 macOS 上设置系统参数..."
  sudo sysctl -w kern.maxfiles=1000000 || echo "警告: 无法设置 kern.maxfiles"
  sudo sysctl -w kern.maxfilesperproc=1000000 || echo "警告: 无法设置 kern.maxfilesperproc"
fi

# 检测可用处理器数量
AVAILABLE_PROCESSORS=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 8)
echo "检测到 $AVAILABLE_PROCESSORS 个处理器"

# 构建应用程序
echo "构建应用程序..."
./gradlew clean build -x test

# 设置 JVM 参数 - 极致优化
JVM_OPTS="-server"

# 内存设置 - 极致优化
JVM_OPTS="$JVM_OPTS -Xms1g -Xmx4g"                               # 固定堆内存大小，避免动态调整
JVM_OPTS="$JVM_OPTS -XX:MetaspaceSize=512m"                      # 元空间初始大小
JVM_OPTS="$JVM_OPTS -XX:MaxMetaspaceSize=1g"                     # 元空间最大大小
JVM_OPTS="$JVM_OPTS -XX:+AlwaysPreTouch"                         # 预分配内存，减少运行时分配开销
JVM_OPTS="$JVM_OPTS -XX:+UseCompressedOops"                      # 使用压缩对象指针
JVM_OPTS="$JVM_OPTS -XX:+UseCompressedClassPointers"             # 使用压缩类指针
JVM_OPTS="$JVM_OPTS -XX:+OptimizeStringConcat"                   # 优化字符串连接
JVM_OPTS="$JVM_OPTS -XX:MaxDirectMemorySize=4g"                  # 直接内存最大值

# 垃圾回收设置 - 极致优化
JVM_OPTS="$JVM_OPTS -XX:+UseG1GC"                                # 使用 G1 垃圾收集器
JVM_OPTS="$JVM_OPTS -XX:+UnlockExperimentalVMOptions"            # 解锁实验性选项
JVM_OPTS="$JVM_OPTS -XX:MaxGCPauseMillis=100"                    # 最大 GC 暂停时间目标
JVM_OPTS="$JVM_OPTS -XX:G1HeapRegionSize=16m"                    # G1 区域大小
JVM_OPTS="$JVM_OPTS -XX:G1NewSizePercent=20"                     # 新生代初始大小百分比
JVM_OPTS="$JVM_OPTS -XX:G1MaxNewSizePercent=30"                  # 新生代最大大小百分比
JVM_OPTS="$JVM_OPTS -XX:InitiatingHeapOccupancyPercent=45"       # 启动并发 GC 的堆占用率
JVM_OPTS="$JVM_OPTS -XX:G1ReservePercent=15"                     # G1 保留内存百分比
JVM_OPTS="$JVM_OPTS -XX:G1MixedGCLiveThresholdPercent=90"        # 混合 GC 存活对象阈值
JVM_OPTS="$JVM_OPTS -XX:G1RSetUpdatingPauseTimePercent=5"        # RSet 更新暂停时间百分比
JVM_OPTS="$JVM_OPTS -XX:+UseNUMA"                                # 启用 NUMA 感知
JVM_OPTS="$JVM_OPTS -XX:+DisableExplicitGC"                      # 禁用显式 GC
JVM_OPTS="$JVM_OPTS -XX:+ParallelRefProcEnabled"                 # 并行引用处理
JVM_OPTS="$JVM_OPTS -XX:ConcGCThreads=$((AVAILABLE_PROCESSORS/2))" # 并发 GC 线程数
JVM_OPTS="$JVM_OPTS -XX:ParallelGCThreads=$AVAILABLE_PROCESSORS" # 并行 GC 线程数
JVM_OPTS="$JVM_OPTS -XX:+PerfDisableSharedMem"                   # 禁用共享内存性能数据
JVM_OPTS="$JVM_OPTS -XX:+UseStringDeduplication"                 # 启用字符串去重

# 网络设置
JVM_OPTS="$JVM_OPTS -Djava.net.preferIPv4Stack=true"             # 优先使用 IPv4
JVM_OPTS="$JVM_OPTS -Dsun.net.inetaddr.ttl=60"                   # DNS 缓存 TTL
JVM_OPTS="$JVM_OPTS -Dsun.net.client.defaultConnectTimeout=5000" # 默认连接超时
JVM_OPTS="$JVM_OPTS -Dsun.net.client.defaultReadTimeout=15000"   # 默认读取超时

# Netty 优化 - 极致性能
JVM_OPTS="$JVM_OPTS -Dio.netty.leakDetection.level=disabled"     # 禁用内存泄漏检测
JVM_OPTS="$JVM_OPTS -Dio.netty.allocator.numHeapArenas=$((AVAILABLE_PROCESSORS*2))" # 堆内存区域数量
JVM_OPTS="$JVM_OPTS -Dio.netty.allocator.numDirectArenas=$((AVAILABLE_PROCESSORS*2))" # 直接内存区域数量
JVM_OPTS="$JVM_OPTS -Dio.netty.allocator.maxOrder=11"            # 最大分配大小
JVM_OPTS="$JVM_OPTS -Dio.netty.allocator.pageSize=8192"          # 页大小
JVM_OPTS="$JVM_OPTS -Dio.netty.allocator.maxCachedBufferCapacity=262144" # 最大缓存容量
JVM_OPTS="$JVM_OPTS -Dio.netty.allocator.tinyCacheSize=2048"     # 小缓存大小
JVM_OPTS="$JVM_OPTS -Dio.netty.allocator.smallCacheSize=1024"    # 小缓存大小
JVM_OPTS="$JVM_OPTS -Dio.netty.allocator.normalCacheSize=512"    # 普通缓存大小
JVM_OPTS="$JVM_OPTS -Dio.netty.noPreferDirect=false"             # 优先使用直接内存
JVM_OPTS="$JVM_OPTS -Dio.netty.noUnsafe=false"                   # 使用 Unsafe 类
JVM_OPTS="$JVM_OPTS -Dio.netty.recycler.maxCapacity=16384"       # 最大回收容量
JVM_OPTS="$JVM_OPTS -Dio.netty.recycler.maxCapacityPerThread=16384" # 每个线程的最大容量
JVM_OPTS="$JVM_OPTS -Dio.netty.buffer.checkBounds=false"         # 禁用边界检查
JVM_OPTS="$JVM_OPTS -Dio.netty.buffer.checkAccessible=false"     # 禁用可访问性检查

# Vert.x 优化 - 极致性能
JVM_OPTS="$JVM_OPTS -Dvertx.maxEventLoopExecuteTime=60000000000" # 最大事件循环执行时间（60秒）
JVM_OPTS="$JVM_OPTS -Dvertx.maxWorkerExecuteTime=600000000000"   # 最大工作线程执行时间（600秒）
JVM_OPTS="$JVM_OPTS -Dvertx.disableMetrics=true"                 # 禁用 Vert.x 指标
JVM_OPTS="$JVM_OPTS -Dvertx.preferNativeTransport=true"          # 使用本地传输
JVM_OPTS="$JVM_OPTS -Dvertx.disableTCCL=true"                    # 禁用线程上下文类加载器
JVM_OPTS="$JVM_OPTS -Dvertx.threadChecks=false"                  # 禁用线程检查
JVM_OPTS="$JVM_OPTS -Dvertx.disableContextTimings=true"          # 禁用上下文计时
JVM_OPTS="$JVM_OPTS -Dvertx.disableHttpHeadersValidation=true"   # 禁用 HTTP 头验证
JVM_OPTS="$JVM_OPTS -Dvertx.eventLoopPoolSize=$((AVAILABLE_PROCESSORS*2))" # 事件循环线程池大小
JVM_OPTS="$JVM_OPTS -Dvertx.workerPoolSize=$((AVAILABLE_PROCESSORS*8))" # 工作线程池大小
JVM_OPTS="$JVM_OPTS -Dvertx.internalBlockingPoolSize=$((AVAILABLE_PROCESSORS*4))" # 内部阻塞线程池大小
JVM_OPTS="$JVM_OPTS -Dvertx.fileResolverCachingEnabled=true"     # 启用文件解析器缓存
JVM_OPTS="$JVM_OPTS -Dvertx.disableWebsockets=false"             # 启用 WebSockets
JVM_OPTS="$JVM_OPTS -Dvertx.flashPolicyHandler=false"            # 禁用 Flash 策略处理器
JVM_OPTS="$JVM_OPTS -Dvertx.warningExceptionTime=30000000000"    # 警告异常时间（30秒）
JVM_OPTS="$JVM_OPTS -Dvertx.blockedThreadCheckInterval=10000"    # 阻塞线程检查间隔（10秒）

# EventBus 优化
JVM_OPTS="$JVM_OPTS -Dapix.eventbus.type=vertx"                  # 使用原生 EventBus

# 配置文件路径
JVM_OPTS="$JVM_OPTS -Dapix.config.path=config/apix.json"         # 应用配置路径
JVM_OPTS="$JVM_OPTS -Dapix.vertx.config.path=src/main/resources/vertx-100k.json" # Vert.x 配置路径

# 调试和监控设置
JVM_OPTS="$JVM_OPTS -XX:+HeapDumpOnOutOfMemoryError"             # 内存溢出时生成堆转储
JVM_OPTS="$JVM_OPTS -XX:HeapDumpPath=./heapdump.hprof"           # 堆转储路径
# 简化GC日志设置
JVM_OPTS="$JVM_OPTS -Xlog:gc=info:file=gc.log:time,uptime:filecount=5,filesize=100m" # GC 日志

# 创建 Vert.x 10万并发配置文件
echo "创建 Vert.x 10万并发配置文件..."
mkdir -p src/main/resources
cat > src/main/resources/vertx-100k.json << EOF
{
  "eventLoopPoolSize": $((AVAILABLE_PROCESSORS*2)),
  "workerPoolSize": $((AVAILABLE_PROCESSORS*8)),
  "internalBlockingPoolSize": $((AVAILABLE_PROCESSORS*4)),
  "blockedThreadCheckInterval": 10000,
  "maxEventLoopExecuteTime": 60000000000,
  "maxWorkerExecuteTime": 600000000000,
  "warningExceptionTime": 30000000000,
  "fileResolverCachingEnabled": true,
  "preferNativeTransport": true,
  "eventBus": {
    "acceptBacklog": 100000,
    "clientAuth": "NONE",
    "connectTimeout": 30000,
    "idleTimeout": 0,
    "receiveBufferSize": 262144,
    "reconnectAttempts": 0,
    "reconnectInterval": 1000,
    "reuseAddress": true,
    "reusePort": true,
    "sendBufferSize": 262144,
    "soLinger": -1,
    "ssl": false,
    "tcpKeepAlive": true,
    "tcpNoDelay": true,
    "trafficClass": -1,
    "trustAll": true
  },
  "httpServerOptions": {
    "acceptBacklog": 100000,
    "compressionLevel": 1,
    "compressionSupported": false,
    "decompressionSupported": false,
    "handle100ContinueAutomatically": true,
    "idleTimeout": 300,
    "maxChunkSize": 65536,
    "maxHeaderSize": 32768,
    "maxInitialLineLength": 16384,
    "maxWebSocketFrameSize": 262144,
    "maxWebSocketMessageSize": 1048576,
    "reuseAddress": true,
    "reusePort": true,
    "tcpFastOpen": true,
    "tcpKeepAlive": true,
    "tcpNoDelay": true,
    "tcpQuickAck": true
  },
  "http2Settings": {
    "headerTableSize": 8192,
    "initialWindowSize": 1048576,
    "maxConcurrentStreams": 100000,
    "maxFrameSize": 16384,
    "maxHeaderListSize": 32768,
    "pushEnabled": false
  }
}
EOF

# 显示 JVM 参数
echo "JVM 参数: $JVM_OPTS"

# 运行应用程序
echo "启动应用程序..."
java $JVM_OPTS -jar build/libs/apix-1.0.0-fat.jar
echo "APIX Gateway 已启动，进程ID: $!"
echo "日志输出到 apix.log"
sleep 5
echo "检查应用程序是否正常启动..."
curl -s http://localhost:8080/api/hello || echo "警告: 无法访问应用程序，请检查日志"
