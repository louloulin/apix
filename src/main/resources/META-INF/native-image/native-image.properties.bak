Args = --initialize-at-build-time=ch.qos,org.slf4j,org.jctools \
       --initialize-at-run-time=io.vertx.ext.web.client.WebClientOptions,io.netty.channel.epoll,io.netty.channel.unix,io.netty.handler.ssl \
       --no-fallback \
       --enable-http \
       --enable-https \
       --enable-url-protocols=http,https \
       --enable-all-security-services \
       --report-unsupported-elements-at-runtime \
       -H:+ReportExceptionStackTraces \
       -H:+PrintClassInitialization \
       -H:+RemoveSaturatedTypeFlows \
       -H:+StackTrace \
       -H:+JNI \
       -H:+AllowIncompleteClasspath \
       -H:IncludeResources=.*/vertx-.*.json \
       -H:IncludeResources=.*/vertx-.*.properties \
       -H:IncludeResources=.*/logback.xml \
       -H:IncludeResources=.*/apix.json \
       -H:+UseServiceLoaderFeature \
       --features=io.vertx.core.spi.VertxServiceProvider \
       --allow-incomplete-classpath \
       --install-exit-handlers \
       --enable-https \
       --enable-url-protocols=http,https,unix \
       --enable-native-access=ALL_UNNAMED \
       --gc=G1 \
       -Dio.netty.noUnsafe=false \
       -Dio.netty.leakDetection.level=disabled \
       -Dvertx.disableDnsResolver=true \
       -Dvertx.disableMetrics=true \
       -Dvertx.disableH2c=true \
       -Dvertx.disableWebsockets=false \
       -Dvertx.flashPolicyHandler=false \
       -Dvertx.threadChecks=false \
       -Dvertx.disableContextTimings=true \
       -Dvertx.disableTCCL=true \
       -Dvertx.disableHttpHeadersValidation=true \
       -Dvertx.eventLoopPoolSize=32 \
       -Dvertx.workerPoolSize=64 \
       -Dvertx.preferNativeTransport=true
