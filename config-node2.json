{
  "gateway": {
    "port": 9090,
    "host": "0.0.0.0"
  },
  "server": {
    "port": 9091,
    "host": "0.0.0.0"
  },
  "admin": {
    "port": 9092,
    "host": "0.0.0.0"
  },
  "health": {
    "port": 9093,
    "host": "0.0.0.0"
  },
  "benchmark": {
    "port": 9094,
    "host": "0.0.0.0"
  },
  "cluster": {
    "enabled": true,
    "mode": "node",
    "nodeId": "node2",
    "host": "localhost",
    "port": 5702,
    "members": ["localhost:5701", "localhost:5702"],
    "type": "hazelcast"
  },
  "plugins": [],
  "routes": [],
  "cache": {
    "type": "semantic",
    "semantic": {
      "embedding": {
        "type": "simple"
      },
      "underlyingCache": {
        "type": "multilevel",
        "caches": [
          {
            "type": "memory"
          }
        ]
      },
      "similarityThreshold": 0.8
    },
    "strategy": {
      "type": "composite",
      "ttlSelectionMode": "MIN",
      "strategies": [
        {
          "type": "ttl",
          "defaultTtl": 3600,
          "keyPatternTtls": {
            "query:.*": 7200
          }
        },
        {
          "type": "model",
          "defaultTtl": 3600,
          "modelTtls": {
            "gpt-3.5-turbo": 7200,
            "gpt-4": 14400
          }
        }
      ]
    }
  }
}
